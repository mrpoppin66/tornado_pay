BOT_TOKEN=
ADMIN_ID=
# Railway подставляет эту переменную автоматически при подключении Postgres-плагина.
# Для локального запуска укажите строку подключения к своей базе, например:
# DATABASE_URL=postgresql://user:password@localhost:5432/tornadopay
DATABASE_URL=

# --- Telegram Mini App ---
# Публичный HTTPS-адрес этого сервиса (без завершающего /), например:
# PUBLIC_BASE_URL=https://your-app.up.railway.app
# Нужен, чтобы бот мог поставить кнопку меню и ссылку "Открыть в приложении".
# Без этой переменной сам Mini App всё равно работает по прямому адресу /webapp/,
# просто кнопки для его быстрого открытия не появятся.
PUBLIC_BASE_URL=
# Порт, на котором слушает встроенный веб-сервер (Mini App + API + вебхук
# xRocket). Railway подставляет PORT автоматически — оставьте пустым на Railway.
PORT=8085
